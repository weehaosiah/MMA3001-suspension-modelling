# Stable line endings keep saved source hashes reproducible across Windows clones.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.html text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.png binary
*.npz binary
*.joblib binary
